# Put inside the existing http{} context (e.g. sites-available).
upstream sanctions_api_upstream {
    include /etc/nginx/snippets/sanctions-active.conf;
    keepalive 16;
}

# Inside the EXISTING TLS server block, preserve certificates, headers and limits.
